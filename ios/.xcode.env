# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
#
# To customize your local machine only, use `.xcode.env.local` (gitignored).
# Do NOT point NODE_BINARY at a versioned Homebrew Cellar path — it breaks after `brew upgrade node`.

# Legacy bridge modules (e.g. @notifee/react-native) need RN core built with legacy arch present.
export RCT_REMOVE_LEGACY_ARCH=0
# Match Podfile: build React Native from source so legacy native modules (Notifee) can register.
export RCT_USE_PREBUILT_RNCORE=0

# Xcode runs build phases with a minimal PATH; `command -v node` often fails. Prefer stable symlinks.
if [ -z "${NODE_BINARY:-}" ]; then
  if [ -x "/opt/homebrew/bin/node" ]; then
    export NODE_BINARY="/opt/homebrew/bin/node"
  elif [ -x "/usr/local/bin/node" ]; then
    export NODE_BINARY="/usr/local/bin/node"
  else
    export NODE_BINARY="$(command -v node 2>/dev/null || true)"
  fi
fi
